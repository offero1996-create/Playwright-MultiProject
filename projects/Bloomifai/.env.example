# Bloomifai — Project environment config
# Copy to .env.staging or .env.dev and fill in real values

BASE_URL=https://app-corestage.platform.bloomifai.com/login
PLATFORM_ORIGIN=https://app-corestage.platform.bloomifai.com

# Login Credentials
LOGIN_EMAIL=your-email@example.com
LOGIN_PASSWORD=your-password

# Secondary user
ALT_LOGIN_EMAIL=secondary@example.com
ALT_LOGIN_PASSWORD=secondary-password

# Admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password
