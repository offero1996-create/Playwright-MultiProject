{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "projects/**/*",
    "config/**/*",
    "utils/**/*",
    "fixtures/**/*",
    "playwright.config.ts",
    "run-tests.js",
    "show-latest-report.js"
  ],
  "exclude": ["node_modules", "dist", "reports"]
}
